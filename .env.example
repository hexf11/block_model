# ── ClickHouse ───────────────────────────────────────────────────────────────
CH_HOST=localhost
CH_PORT=9000
CH_USER=default
CH_PASSWORD=
CH_DATABASE=pm
CH_BATCH_SIZE=200

# JSONL 兜底，ClickHouse 不可达时保证数据不丢
BACKUP_DIR=./data/raw

# 写入 ClickHouse 的目标币种（逗号分隔，JSONL 仍存全量）
TARGET_SYMBOLS=btc/usd,eth/usd,sol/usd,xrp/usd,doge/usd

# ── RTDS (Polymarket Chainlink TWAP) ─────────────────────────────────────────
RTDS_URL=wss://ws-live-data.polymarket.com
RTDS_PING_INTERVAL=5
RTDS_STALE_TIMEOUT=30
RTDS_BACKOFF_INIT=1
RTDS_BACKOFF_MAX=60

# ── 交易所采集器 ──────────────────────────────────────────────────────────────
EX_STALE_TIMEOUT=20
EX_PING_INTERVAL=15
EX_BACKOFF_INIT=1
EX_BACKOFF_MAX=60

# ── 推理服务 ──────────────────────────────────────────────────────────────────
INFERENCE_HOST=127.0.0.1
INFERENCE_PORT=8765

# 选哪套模型。每套模型训练完写 models/{name}/model.onnx + calibration.json：
#   模型目录/ONNX 签名（extract）      推理端如何取 P(UP)
#   lightgbm   seq(map(int64,float))   Rust 按 OutputKind::ZipMap 取 key=1
#   tcn_lstm   tensor(float)[N,2]      Rust 按 OutputKind::Tensor2 取第 1 列
# 换模型只改下面两行，Rust 推理端按输出类型自动提取。
# 用 research/compare.py 选出当前最优，再指过去。（二进制不提交 git，
# 各模型 artifacts 由 train_*.py 在服务器上用接口或数据重新生成。）
MODEL_PATH=./models/lightgbm/model.onnx
CALIBRATION_PATH=./models/lightgbm/calibration.json
