# ── ClickHouse ───────────────────────────────────────────────────────────────
CH_HOST=localhost
CH_PORT=9000
CH_USER=default
CH_PASSWORD=
CH_DATABASE=pm
CH_BATCH_SIZE=200

# JSONL 兜底，ClickHouse 不可达时保证数据不丢
BACKUP_DIR=./data/raw

# 写入 ClickHouse 的目标币种（逗号分隔，JSONL 仍存全量）
TARGET_SYMBOLS=btc/usd,eth/usd,sol/usd,xrp/usd,doge/usd

# ── RTDS (Polymarket Chainlink TWAP) ─────────────────────────────────────────
RTDS_URL=wss://ws-live-data.polymarket.com
RTDS_PING_INTERVAL=5
RTDS_STALE_TIMEOUT=30
RTDS_BACKOFF_INIT=1
RTDS_BACKOFF_MAX=60

# ── 交易所采集器 ──────────────────────────────────────────────────────────────
EX_STALE_TIMEOUT=20
EX_PING_INTERVAL=15
EX_BACKOFF_INIT=1
EX_BACKOFF_MAX=60

# ── 推理服务 ──────────────────────────────────────────────────────────────────
INFERENCE_HOST=127.0.0.1
INFERENCE_PORT=8765
MODEL_PATH=./models/model.onnx
CALIBRATION_PATH=./models/calibration.json
